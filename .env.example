# Credenciales de Base de Datos PostgreSQL[cite: 1]
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_segura
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_bd

# Configuración de Flask[cite: 1]
FLASK_APP=run.py # o app.py dependiendo de tu archivo de entrada
FLASK_DEBUG=1 # Usa 1 para desarrollo, 0 para producción
SECRET_KEY=escribe_una_clave_secreta_aleatoria_aqui

# Configuración de SMTP para recuperación de contraseña[cite: 1]
SMTP_USER=tu_correo@ejemplo.com
SMTP_PASS=tu_contraseña_de_aplicacion_smtp

# Configuración de CAPTCHA (Cloudflare Turnstile)[cite: 1]
CAPTCHA_SITE_KEY=1x00000000000000000000AA # Reemplaza con tu Site Key
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA # Reemplaza con tu Secret Key

# Configuración de subida de archivos[cite: 1]
UPLOAD_FOLDER=ruta/de/archivos
MAX_CONTENT_LENGTH=16777216 # Tamaño en bytes (Ej: 16777216 = 16 MB)