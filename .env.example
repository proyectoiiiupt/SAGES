# ========================================
# CONFIGURACIÓN DE FLASK (Líneas 1-6)
# Configuración básica de la aplicación Flask
# ========================================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=clave_secreta_generada_aqui

# ========================================
# BASE DE DATOS POSTGRESQL (Líneas 8-12)
# Cadena de conexión a base de datos PostgreSQL
# ========================================
# Reemplaza con tus datos: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:root@localhost:5432/sages

# ========================================
# CONFIGURACIÓN DE CORREO SMTP (Líneas 14-25)
# Variables de entorno para sistema de emails de recuperación de contraseña
# ========================================
MAIL_SERVER=smtp.gmail.com              # Servidor SMTP (Gmail por defecto)
MAIL_PORT=587                          # Puerto SMTP (587 para TLS, 465 para SSL)
MAIL_USE_TLS=True                      # Habilitar encriptación TLS
MAIL_USERNAME=tu_correo@gmail.com       # Tu correo para autenticación SMTP
MAIL_PASSWORD=tu_clave_de_aplicacion    # Contraseña de aplicación de Gmail (NO tu contraseña normal)
MAIL_DEFAULT_SENDER=tu_correo@gmail.com # Remitente por defecto
MAIL_MAX_EMAILS=10                      # Límite de emails por lote
MAIL_SUPPRESS_SEND=False                # Si True, suprime envío real (útil para testing)